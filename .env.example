# Frontend build-time API origin
VITE_API_URL=https://sih100-production.up.railway.app

# Backend runtime configuration
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=https://chatlyme.xyz,https://www.chatlyme.xyz,http://localhost:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Mount a Railway Volume at /data and set UPLOAD_DIR=/data/uploads for persistence
UPLOAD_DIR=/data/uploads

# Gemini API (configure in Railway backend Variables; never expose to frontend)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_DOCUMENT_TEXT_LIMIT=12000

# Optional AI fallback: must be reachable from the Railway backend (not localhost on your Mac)
OLLAMA_BASE_URL=https://your-secure-ollama-endpoint.example
OLLAMA_MODEL=llama3-groq-tool-use:8b
OLLAMA_API_KEY=

# Optional Resend notifications (configured only on the backend service)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TenderHub <notifications@your-verified-domain.example>
