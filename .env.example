# Frontend build-time API origin
VITE_API_URL=https://sih100-production-3f7d.up.railway.app

# Backend runtime configuration
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Mount a Railway Volume at /data and set UPLOAD_DIR=/data/uploads for persistence
UPLOAD_DIR=./uploads

# Gemini API (configure in Railway backend Variables; never expose to frontend)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_DOCUMENT_TEXT_LIMIT=12000
